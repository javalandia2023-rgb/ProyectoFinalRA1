<Window x:Class="ProyectoFinal.WPFClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Panel de Control - Proyecto Final" Height="600" Width="900" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Menú Lateral -->
        <StackPanel Grid.Column="0" Background="#2C3E50">
            <TextBlock Text="MENÚ" Foreground="White" FontSize="18" FontWeight="Bold" Margin="10,20,10,10" HorizontalAlignment="Center"/>

            <Button x:Name="BtnMaster" Content="Ver Vehículos (Master)" Margin="10" Height="40" Click="BtnMaster_Click"/>
            <Button x:Name="BtnMcp" Content="Consultas MCP (IA)" Margin="10" Height="40" Click="BtnMcp_Click"/>
            <Button x:Name="BtnSalir" Content="Cerrar Sesión" Margin="10,50,10,10" Height="40" Click="BtnSalir_Click"/>
        </StackPanel>

        <!-- Área de Contenido (Aquí se abrirán las ventanas hijas) -->
        <Grid x:Name="MainContentArea" Grid.Column="1" Background="#ECF0F1">
            <TextBlock Text="Bienvenido. Selecciona una opción del menú." HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" Foreground="Gray"/>
        </Grid>
    </Grid>
</Window>
