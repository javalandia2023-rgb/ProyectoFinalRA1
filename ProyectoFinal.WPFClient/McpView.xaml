<UserControl x:Class="ProyectoFinal.WPFClient.McpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 0: Título -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Etiqueta -->
            <RowDefinition Height="Auto"/>
            <!-- 2: TextBox de pregunta -->
            <RowDefinition Height="Auto"/>
            <!-- 3: Botón -->
            <RowDefinition Height="*"/>
            <!-- 4: Área de respuesta -->
        </Grid.RowDefinitions>

        <TextBlock Text="Consultas en Lenguaje Natural (MCP)" Grid.Row="0" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

        <TextBlock Text="Escribe tu pregunta:" Grid.Row="1" Margin="0,5"/>
        <TextBox x:Name="txtPregunta" Grid.Row="2" Padding="5" Height="40"/>

        <Button x:Name="BtnPreguntar" Content="Preguntar a la IA" Grid.Row="3" Width="150" Height="30" Margin="0,10,0,0" Click="BtnPreguntar_Click"/>

        <!-- Área para mostrar la respuesta -->
        <TextBox x:Name="txtRespuesta" Grid.Row="4" Margin="0,20,0,0" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="5"/>
    </Grid>
</UserControl>
