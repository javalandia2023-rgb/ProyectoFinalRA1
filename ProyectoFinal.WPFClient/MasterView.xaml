<UserControl x:Class="ProyectoFinal.WPFClient.MasterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ProyectoFinal.WPFClient.ViewModels">

    <!-- Aquí conectamos la Vista con el ViewModel -->
    <UserControl.DataContext>
        <vm:MasterViewModel />
    </UserControl.DataContext>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- El botón ahora usa Command en lugar de Click -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Cargar Vehículos" Width="120" Height="30" Command="{Binding CargarCommand}"/>
            <Button Content="Nuevo Vehículo" Width="120" Height="30" Margin="10,0,0,0" Click="BtnNuevo_Click"/>
        </StackPanel>

        <!-- 
        DataGrid con columnas personalizadas.
        Se ha cambiado AutoGenerateColumns a "False" para controlar manualmente las columnas.
        Se añade una columna de tipo "DataGridTemplateColumn" que contiene dos botones (Editar y Eliminar).
        Cada botón está enlazado a un comando del ViewModel (EditarCommand y EliminarCommand) mediante Binding.
        El parámetro "CommandParameter={Binding}" pasa el objeto Vehiculo completo al comando, 
        permitiendo saber qué fila se está editando o eliminando.
        -->
        <DataGrid Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" 
                  ItemsSource="{Binding Vehiculos}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Marca" Binding="{Binding Marca}" Width="100"/>
                <DataGridTextColumn Header="Modelo" Binding="{Binding Modelo}" Width="120"/>
                <DataGridTextColumn Header="Año" Binding="{Binding Año}" Width="60"/>
                <DataGridTextColumn Header="Precio" Binding="{Binding Precio}" Width="80"/>
                <DataGridTextColumn Header="Combustible" Binding="{Binding TipoCombustible}" Width="100"/>

                <DataGridTemplateColumn Header="Acciones" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Editar" Width="60" Margin="2" 
                                        Command="{Binding DataContext.EditarCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}" />
                                <Button Content="Eliminar" Width="60" Margin="2" 
                                        Command="{Binding DataContext.EliminarCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</UserControl>